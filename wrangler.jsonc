{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vme-ips-reflection",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vme-ips-reflection"
    }
  ]
}
